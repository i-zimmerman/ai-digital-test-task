# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/review_signal

# Anthropic — required only to RUN the pipeline.
# The UI works without it: `pnpm seed` loads the committed snapshot.
ANTHROPIC_API_KEY=

# Pipeline knobs (optional; defaults shown)
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
LLM_BATCH_SIZE=20
LLM_CONCURRENCY=4
DEDUP_THRESHOLD=0.88

# API
PORT=3001
